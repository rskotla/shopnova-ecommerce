apiVersion: apps/v1
kind: Deployment
metadata:
  name: shopnova-web
  namespace: shopnova
spec:
  replicas: 2
  selector:
    matchLabels:
      app: shopnova-web
  template:
    metadata:
      labels:
        app: shopnova-web
    spec:
      containers:
        - name: web
          image: rohitkotla/shopnova-web:10
          imagePullPolicy: Always
          ports:
            - containerPort: 80
---
apiVersion: v1
kind: Service
metadata:
  name: web
  namespace: shopnova
spec:
  type: ClusterIP
  selector:
    app: shopnova-web
  ports:
    - port: 80
      targetPort: 80
